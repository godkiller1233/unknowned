# Never commit real passwords. Set these in the hosting provider or local environment.
OFFICIAL_ACCOUNT_USERNAME=Unknown
OFFICIAL_ACCOUNT_PASSWORD=replace-with-a-long-random-password

# Optional additional privileged bootstrap accounts.
# Leave unset to avoid creating the account.
ADMIN_USERNAME=
ADMIN_PASSWORD=
OWNER_USERNAME=
OWNER_PASSWORD=
FOUNDER_USERNAME=
FOUNDER_PASSWORD=

# Required in production (at least 32 random characters)
JWT_SECRET=replace-with-at-least-32-random-characters

# Comma-separated browser origins allowed to call the API, for example:
# https://your-frontend.example.com
CORS_ORIGIN=

# Set this in Render's environment variables; do not commit database passwords.
DATABASE_URL=postgresql://user:password@host/database
