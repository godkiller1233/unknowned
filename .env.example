# Never commit real passwords. Set these in the hosting provider or local environment.
OFFICIAL_ACCOUNT_USERNAME=Unknown
OFFICIAL_ACCOUNT_PASSWORD=replace-with-a-long-random-password

# Optional additional privileged bootstrap accounts.
# Leave unset to avoid creating the account.
ADMIN_USERNAME=
ADMIN_PASSWORD=
OWNER_USERNAME=
OWNER_PASSWORD=
FOUNDER_USERNAME=
FOUNDER_PASSWORD=

# Required in production (at least 32 random characters)
JWT_SECRET=replace-with-at-least-32-random-characters

# Comma-separated browser origins allowed to call the API, for example:
# https://your-frontend.example.com
CORS_ORIGIN=

# Set this in Render's environment variables; do not commit database passwords.
DATABASE_URL=postgresql://user:password@host/database


# --- WebRTC TURN (voice/video calls) ---
# Optional fallback. Prefer the Owner Console (Admin panel -> Voice relay (TURN)
# settings): values saved there are stored in the shared PostgreSQL database, so
# every server instance serves the same relay without environment changes or a
# restart. The variables below are used only when the database value is empty.
# Comma-separated TURN urls to relay media for users behind symmetric NAT, e.g.
# turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# Leave empty to use only the public STUN fallback (most calls still connect).
TURN_URLS=
# Credentials for the TURN server above (sent on every TURN url). Both are
# required to authenticate; otherwise the urls are used without credentials.
TURN_USERNAME=
TURN_CREDENTIAL=
